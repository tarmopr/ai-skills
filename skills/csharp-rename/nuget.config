<?xml version="1.0" encoding="utf-8"?>
<!-- Builds the tool from nuget.org only, so a developer's private feeds or package source mapping can't break it. -->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
  <packageSourceMapping>
    <clear />
  </packageSourceMapping>
</configuration>
